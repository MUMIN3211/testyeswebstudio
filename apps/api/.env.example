# Supabase connection string. On Vercel use the pooler (Supabase dashboard > Connect > Transaction pooler, port 6543):
# the direct db.<ref>.supabase.co host is IPv6-only and not reachable from Vercel.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Comma-separated origins allowed to call the API (add your Vercel web URL in production).
CORS_ORIGINS=http://localhost:3000
